# Docker Compose reads .env automatically. The Java process needs these as
# environment variables; it does not load .env files automatically.
DB_PASSWORD=replace-with-a-local-development-password
DB_URL=jdbc:postgresql://localhost:5432/translator
DB_USER=translator
JWT_ISSUER=translator
JWT_PRIVATE_KEY_LOCATION=file:./secrets/jwt-private.pem
JWT_AUDIENCE=translator-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
AUTH_REQUESTS_PER_MINUTE=30
REGISTRATION_ENABLED=false
GLOBAL_CONCURRENT_REQUESTS=8
GLOBAL_DAILY_TOKENS=2000000
REQUEST_BODY_TIMEOUT=5s
CONCURRENT_REQUEST_BODIES=16
OPENAI_API_KEY=replace-with-your-server-side-api-key
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_QUALITY_MODEL=gpt-4.1
