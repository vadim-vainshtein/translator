# Copy to .env, then replace the four secrets below before starting Compose.
# Single quotes preserve literal dollar signs and hash characters in secrets.
DB_PASSWORD='replace-with-a-strong-database-password'
# Set a unique administrator password of at least 12 characters and at most 72 UTF-8 bytes.
ADMIN_PASSWORD=
OPENAI_API_KEY='replace-with-your-server-side-api-key'
# Paste a persistent, unencrypted PKCS#8 RSA PEM key (at least 2048 bits).
# The surrounding single quotes are required for this multiline value.
JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----
replace-with-the-complete-base64-key-body
-----END PRIVATE KEY-----'

# Docker Compose reads .env automatically and passes these settings to the app.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
POSTGRES_PORT=5432
JWT_ISSUER=translator
JWT_AUDIENCE=translator-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
AUTH_REQUESTS_PER_MINUTE=30
GLOBAL_CONCURRENT_REQUESTS=8
GLOBAL_DAILY_TOKENS=2000000
REQUEST_BODY_TIMEOUT=5s
CONCURRENT_REQUEST_BODIES=16
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_QUALITY_MODEL=gpt-4.1
